# Másold át .env néven és töltsd ki a Firebase Console értékeivel.
# A VITE_ prefix kötelező – csak így olvassa be a Vite a kliens oldali kódban.

# Firebase Web App config (Project settings → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Seed / migration scriptek (Node.js, Admin SDK) ---
# Service account JSON útvonala a projekt gyökeréhez képest (opcionális).
# Ha nincs megadva, a script a firebase-service-account.json fájlt keresi a gyökérben.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
